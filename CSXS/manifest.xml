<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.cinematic.retrofilm" ExtensionBundleVersion="1.0.0"
        ExtensionBundleName="RetroFilm Color &amp; Effects" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.cinematic.retrofilm.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- PPRO = Adobe Premiere Pro (v14.0 CC 2020 through v25.0+ 2025/2026) -->
            <Host Name="PPRO" Version="[14.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.cinematic.retrofilm.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEPEngine>
                        <CommandLine>
                            <Parameter>--enable-nodejs</Parameter>
                            <Parameter>--mixed-context</Parameter>
                            <Parameter>--enable-webgl</Parameter>
                        </CommandLine>
                    </CEPEngine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>RetroFilm Color &amp; Effects</Menu>
                    <Geometry>
                        <Size>
                            <Height>720</Height>
                            <Width>380</Width>
                        </Size>
                        <MinSize>
                            <Height>450</Height>
                            <Width>300</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1600</Height>
                            <Width>1200</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
